# CodeMentor AI - backend environment template.
# Copy to backend/.env and fill in real values. backend/.env is git-ignored.
#
# Only ONE key is required to start: GROQ_API_KEY.
# Add more provider keys to enable automatic fallback.

# --- Core ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./codementor.db
# Production: DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM layer (switching provider is a config change only) ---
LLM_PROVIDER=groq
LLM_FALLBACKS=gemini,openai,anthropic
LLM_MODEL=
LLM_API_KEY=

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Rate limits ---
RATE_LIMIT_MENTOR=30/minute

# --- Email (solve notifications only) ---
# console: prints recipient + subject to stdout (dev). smtp: real delivery
# via SMTP. resend: real delivery via the Resend HTTP API.
EMAIL_PROVIDER=console
EMAIL_SENDER=CodeMentor AI <noreply@example.com>
RESEND_API_KEY=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
