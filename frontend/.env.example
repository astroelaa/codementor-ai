# Frontend environment template. Copy to frontend/.env.local to override.
# Empty VITE_API_BASE_URL = talk to the local backend during development.
# Canonical backend variable (also used by .github/workflows/pages.yml and the
# Vercel frontend project's Production env):
#   VITE_API_BASE_URL=https://codementor-ai-api.vercel.app
VITE_API_BASE_URL=
# Legacy fallback, still honoured by src/lib/api.ts:
# VITE_API_URL=https://codementor-ai-api.vercel.app

# Supabase project URL and public anon key. Both are safe to ship in a
# browser; Row Level Security protects every table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hosting base path (build-time only). Default /codementor-ai/ is correct for
# GitHub Pages. For a Vercel root-domain deploy set VITE_BASE_PATH=/
# VITE_BASE_PATH=/
