# CodeMentor AI - backend environment template.
# Copy to backend/.env and fill in real values. backend/.env is git-ignored.
#
# Supabase provides authentication and PostgreSQL. Set the Supabase values
# first, then one LLM provider key. The database defaults to local SQLite for
# development; production requires the Supabase PostgreSQL URL.

# --- Core ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./codementor.db
# Production: use the Supabase session-pooler PostgreSQL URL with
# sslmode=require. Do not commit the value.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase ---
# Project URL and public anon key (safe for tests/tooling; the runtime verifies
# access tokens with the project's JWKS).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Used only to delete the Supabase Auth user on account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM layer (switching provider is a config change only) ---
LLM_PROVIDER=groq
LLM_FALLBACKS=gemini,openai,anthropic
LLM_MODEL=
LLM_API_KEY=

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Rate limits ---
RATE_LIMIT_MENTOR=30/minute

# --- Solve-notification email (optional) ---
# console: logs recipient + subject locally. smtp: SMTP delivery. resend: API.
EMAIL_PROVIDER=console
EMAIL_SENDER=CodeMentor AI <noreply@example.com>
RESEND_API_KEY=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
