# Frontend environment template. Copy to frontend/.env to override.
# Empty = talk to the local backend during development.
# Canonical variable (also used by .github/workflows/pages.yml):
# Production (GitHub Pages): VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_BASE_URL=
# Legacy fallback, still honoured by src/lib/api.ts:
# VITE_API_URL=https://your-api.onrender.com
# Hosting base path (build-time only). Default /codementor-ai/ is correct for
# GitHub Pages. For a Vercel root-domain deploy set VITE_BASE_PATH=/
